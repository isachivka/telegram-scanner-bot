# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather. Leave empty to run the MCP server only.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (in private chats
# and in any group). Empty = nobody: send /start to the bot and it replies with your ID.
ALLOWED_USER_IDS=
# Group chats where *every* member may use the bot (IDs are negative, e.g.
# -1001234567890). Add the bot to the group, send /status as an allowed user,
# and it shows the chat ID. In other groups the bot ignores strangers silently.
#ALLOWED_CHAT_IDS=
# Interface language: en | ru
BOT_LANGUAGE=en

# ── Scanner ─────────────────────────────────────────────────────────────────
# eSCL (AirScan) URL of the scanner; most network MFPs speak it at /eSCL.
# Find yours with `airscan-discover` (run it inside the container).
SCANNER_URL=http://192.168.1.50/eSCL
# SANE device name (`scanimage -L`). Optional; derived from SCANNER_URL when
# unset, and left to SANE's own discovery when both are empty.
#SCANNER_DEVICE=airscan:e0:Scanner
# Colour modes to cycle through in the bot, exactly as `scanimage --mode` names them.
#SCAN_MODES=Color,Gray
#SCAN_DEFAULT_MODE=Color
#SCAN_DPI_OPTIONS=200,300,600
#SCAN_DEFAULT_DPI=300
# `--source` for single-page scans (usually not needed).
#SCAN_SOURCE=Flatbed
# `--source` name of the automatic document feeder. Setting it enables the
# "scan the whole feeder" button / MCP `source=feeder`.
#SCAN_ADF_SOURCE=ADF
# jpeg | png
#SCAN_FORMAT=jpeg
# Anything extra to pass to scanimage, e.g. page size or brightness.
#SCANIMAGE_EXTRA_ARGS=-x 210 -y 297
#SCAN_TIMEOUT_SEC=180

# ── Printer (optional) ──────────────────────────────────────────────────────
# CUPS queue name (`lpstat -p`). Leave empty to disable printing.
PRINTER_QUEUE=
# CUPS server the container talks to; with network_mode: host the default
# (localhost:631) reaches a CUPS running on the same machine.
#CUPS_SERVER=localhost:631
#PRINT_COPIES_OPTIONS=1,2,3,5,10
#PRINT_MAX_FILE_MB=20

# ── MCP server (optional) ───────────────────────────────────────────────────
# Expose the MCP endpoint over HTTP so Claude Code, Codex, Cursor… can scan and
# print. Both must be set; generate a token with `openssl rand -hex 24`.
#MCP_HTTP_PORT=8765
#MCP_AUTH_TOKEN=
#MCP_HTTP_HOST=0.0.0.0
#MCP_HTTP_PATH=/mcp
# Scans and uploads travel as signed links (http://<this host>:<port>/files/...).
# The host part is taken from the request unless you set it explicitly, e.g.
# when behind a reverse proxy or reachable by a DNS name.
#PUBLIC_URL=http://scanner.lan:8765
# How long a link stays valid, seconds (default 7 days).
#FILE_LINK_TTL_SEC=604800
# Largest file accepted by PUT /files/uploads/<name> and by print_file url=.
#UPLOAD_MAX_MB=50
# Where MCP scans and uploads are stored (a volume in docker-compose.yml).
#SCAN_OUTPUT_DIR=/data/scans

# ── Paper photos → Immich (optional) ────────────────────────────────────────
# Scan one photo at a time, crop it, ask when/where it was taken, upload to
# Immich with that date, location and description. Setting IMMICH_URL and a key
# adds "Photo → Immich" to the main menu.
#IMMICH_URL=http://192.168.1.10:2283
# What people open on their phones; links in the chat use it.
#IMMICH_PUBLIC_URL=https://photos.example.com
# Account settings → API keys. Permissions: asset.upload, asset.read,
# asset.update, album.create, album.read, albumAsset.create, albumUser.create.
#IMMICH_API_KEY=
# Per-person libraries: <telegram user id>:<api key>, comma-separated.
#IMMICH_API_KEYS=
#IMMICH_ALBUM=Scanned photos
# Immich user ids (Administration → Users) added as editors to a new album.
#IMMICH_ALBUM_SHARE_WITH=
#PHOTO_DPI=600
# auto | escl | sane — auto talks eSCL to SCANNER_URL directly, which gets the
# scanner's optical resolution even when it advertises less.
#PHOTO_SCAN_VIA=auto
# Nominatim-compatible geocoder; empty = keep places as text only.
#GEOCODER_URL=https://nominatim.openstreetmap.org

# ── Misc ────────────────────────────────────────────────────────────────────
# Timezone for the timestamps in scan file names (scan-YYYYMMDD-HHMMSS.pdf).
#TZ=Europe/Berlin
#LOG_LEVEL=info
