{
  "name": "telegram-scanner-bot",
  "version": "1.2.3",
  "private": true,
  "description": "Self-hosted Telegram bot that turns any SANE/eSCL network scanner into a scan-to-PDF and paper-photos-to-Immich service and any CUPS printer into a print-from-chat service",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "node dist/index.js --check",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "async-mutex": "^0.5.0",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
